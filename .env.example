# ---------------------------------------------------------------------------
# Personal AI Lead Hunter — copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Postgres 16. The default below matches a local `brew install postgresql@16`
# server (note: Homebrew's is on 5433 when 5432 is taken).
DATABASE_URL="postgresql://lead_hunter:lead_hunter_dev_pw@127.0.0.1:5433/lead_hunter_dev"
# Used by `npm run test` only.
TEST_DATABASE_URL="postgresql://lead_hunter:lead_hunter_dev_pw@127.0.0.1:5433/lead_hunter_test"

# --- Dashboard auth (single owner, README §34) ------------------------------
# Preferred: an scrypt hash produced by `npm run set-password`.
# The encoding is colon-separated and needs no quotes or escaping, because
# dotenv and @next/env both expand `$VAR` inside .env values.
OWNER_PASSWORD_HASH=
# Dev-only fallback used when OWNER_PASSWORD_HASH is empty. Remove before deploying.
OWNER_PASSWORD=
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional. Shown on the login page. Must be a URL on this same host.
APP_URL="http://localhost:3000"

# --- AI provider (README §26) ----------------------------------------------
# auto | openai | anthropic | heuristic
#
# `auto` (default) uses the first provider that has a key: the free
# OpenAI-compatible one, then Anthropic, then the keyless rules. So the whole
# switch is "paste a key in AI_API_KEY" — the app never breaks without one.
AI_PROVIDER="auto"

# ---- Free path: any OpenAI-compatible /chat/completions endpoint ----------
# Google AI Studio is the default (free tier, no card, native JSON-schema
# output, ~1M-token context). Get a key at https://aistudio.google.com/apikey
AI_API_KEY=""
# Shortcut: paste the key in the app instead — Settings → API keys writes
# this very line (values with `$` or line breaks are refused there).
# Swap the endpoint to use another free provider instead — one line each:
#   Groq        https://api.groq.com/openai/v1            (AI_MODEL="qwen/qwen3.8-27b")
#   OpenRouter  https://openrouter.ai/api/v1              (AI_MODEL="nvidia/nemotron-3.5-super-vl:free")
#   Mistral     https://api.mistral.ai/v1                 (AI_MODEL="mistral-small-4")
#   Ollama      http://127.0.0.1:11434/v1                 (AI_MODEL="qwen3:8b", AI_API_KEY="ollama")
AI_BASE_URL=""
# Leave both empty to use the selected provider's own defaults
# (Gemini: gemini-3.8-flash + gemini-3.5-flash-lite).
AI_MODEL=""
AI_MODEL_FAST=""

# ---- Paid path: Anthropic (optional, kept as an alternative) ---------------
ANTHROPIC_API_KEY=""
# "low" | "medium" | "high" | "xhigh" | "max" — thinking depth for the strong tier.
AI_EFFORT="high"

# Hard ceiling on model calls per day, free or paid; guards against a runaway loop.
AI_DAILY_CALL_LIMIT="250"

# --- Notifications (README §24) — Phase 6, optional -------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""

# --- Sources (README §5) ----------------------------------------------------
# Reddit REQUIRES OAuth for programmatic search now; unauthenticated
# www.reddit.com/search.json is blocked (HTTP 403). Create a free "script" app at
# https://www.reddit.com/prefs/apps and copy its id/secret here. The app is
# read-only: it only calls /search.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="lead-hunter/0.1 (personal use)"
# Per-request timeout and retry budget for the Reddit adapter.
REDDIT_TIMEOUT_MS="15000"
# Optional: point the adapter at a proxy, a mirror, or a local stub when testing.
REDDIT_BASE_URL=""
REDDIT_OAUTH_URL=""

# ---- Perplexity Search API (optional, paid) --------------------------------
# Web search results as a second discovery source. Billed per successful request
# ($5/1,000 standard, $1/1,000 fast), so the adapter is only registered when this
# key is set. Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=""
PERPLEXITY_BASE_URL=""
# 1-20 results per query.
PERPLEXITY_MAX_RESULTS="10"
# hour | day | week | month | year — empty means no recency filter.
PERPLEXITY_RECENCY="week"
# web | fast (fast is cheaper and shallower).
PERPLEXITY_SEARCH_TYPE="web"
PERPLEXITY_TIMEOUT_MS="20000"

# --- Background jobs (README §28) ------------------------------------------
# How long a discovery run may hold the single-run lock before the next run may
# take it over (crashed process recovery).
HUNT_LOCK_MINUTES="60"
# Optional and currently unused by the app: the scheduler is cron/launchd, not a
# queue. Kept only if a future queue worker adopts it.
REDIS_URL=""

# --- Logging ---------------------------------------------------------------
LOG_LEVEL="info"
